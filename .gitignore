# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
backend/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# backend build output
backend/dist

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env.development
backend/.env
backend/.env.production
# frontend .env.production is intentionally NOT ignored — only public
# NEXT_PUBLIC_* URLs, no secrets, and committing it is what guarantees a
# server build always picks up the right domain without a manual deploy step.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
