# Same Postgres database launchpad_v5's backend uses
DATABASE_URL=postgresql://user:password@localhost:5432/founderos

# MUST match launchpad_v5 backend/.env's JWT_SECRET exactly — this app verifies
# the bridge token launchpad_v5 mints, not its own tokens.
LAUNCHPAD_JWT_SECRET=

ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

PORT=3601
ALLOWED_ORIGINS=http://localhost:3600
